---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import Story from '../components/Story.astro';
import Interior from '../components/Interior.astro';
import Tech from '../components/Tech.astro';
import Trims from '../components/Trims.astro';
import Registration from '../components/Registration.astro';
import Credit from '../components/Credit.astro';
import Specs from '../components/Specs.astro';
import Gallery from '../components/Gallery.astro';
import WhyUs from '../components/WhyUs.astro';
import Faq from '../components/Faq.astro';
import LeadSection from '../components/LeadSection.astro';
import Catalog from '../components/Catalog.astro';
import Contacts from '../components/Contacts.astro';
import { models } from '../data/models';
import { companyFaq } from '../data/company';
import { site } from '../config/site';
import { absUrl } from '../config/paths';
import { maxPrice, minPrice } from '../scripts/format';
import { bodyLabels, fullName, type CarModel } from '../data/types';

export function getStaticPaths() {
  return models.map((model) => ({ params: { slug: model.slug }, props: { model } }));
}

const { model } = Astro.props as { model: CarModel };
const name = fullName(model);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const others = models.filter((m) => m.slug !== model.slug);
const faq = model.faq?.length ? model.faq : companyFaq;

const nav = [
  model.chapters?.length ? { href: '#story', label: 'О модели' } : null,
  { href: '#trims', label: 'Цены' },
  { href: '#registration', label: 'Учёт РФ/КГ' },
  { href: '#credit', label: 'Кредит' },
  { href: '#contacts', label: 'Контакты' },
].filter((x) => x !== null);

const dealer = {
  '@type': 'AutoDealer',
  '@id': absUrl('/#dealer', Astro.site),
  name: site.name,
  telephone: site.phone,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressRegion: site.region,
    streetAddress: site.address,
    addressCountry: 'RU',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lon },
  url: absUrl('/', Astro.site),
};

const jsonLd = [
  { '@context': 'https://schema.org', ...dealer },
  {
    '@context': 'https://schema.org',
    '@type': 'Car',
    name,
    brand: { '@type': 'Brand', name: model.brand },
    model: model.name,
    bodyType: bodyLabels[model.body],
    seatingCapacity: model.seats,
    modelDate: String(model.year),
    url: pageUrl,
    image: model.hero.src ? new URL(model.hero.src.src, Astro.site).href : undefined,
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: 'RUB',
      lowPrice: Math.min(minPrice(model.trims, 'rf'), minPrice(model.trims, 'kg')),
      highPrice: Math.max(maxPrice(model.trims, 'rf'), maxPrice(model.trims, 'kg')),
      offerCount: model.trims.length * 2,
      availability: model.availability === 'in-stock' ? 'https://schema.org/InStock' : 'https://schema.org/PreOrder',
      seller: { '@id': dealer['@id'] },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const trimOptions = model.trims.map((t) => ({ id: t.id, name: t.name }));
---

<Base
  title={model.seo.title}
  description={model.seo.description}
  ogImage={model.hero.src?.src}
  jsonLd={jsonLd}
  nav={nav}
  model={name}
  trims={trimOptions}
>
  <Hero model={model} />
  <Stats stats={model.stats} note={model.statsNote} />
  {model.chapters?.length ? <Story chapters={model.chapters} /> : null}
  {model.interior && <Interior interior={model.interior} />}
  {model.gallery?.length ? <Gallery photos={model.gallery} /> : null}
  {model.tech && <Tech tech={model.tech} />}
  <Trims trims={model.trims} colors={model.colors} />
  <Registration />
  <Credit models={[model]} />
  <Specs specs={model.specs} name={name} note={model.specsNote} />
  <WhyUs />
  <Faq items={faq} />
  <LeadSection model={name} trims={trimOptions} photo={model.ctaPhoto ?? model.hero} />
  {others.length > 0 && <Catalog models={others} id="more" eyebrow="Модельный ряд" title="Другие модели" filters={false} alt />}
  <Contacts />
</Base>
