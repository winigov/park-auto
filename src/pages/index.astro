---
import Base from '../layouts/Base.astro';
import Showcase from '../components/Showcase.astro';
import Catalog from '../components/Catalog.astro';
import Registration from '../components/Registration.astro';
import Credit from '../components/Credit.astro';
import WhyUs from '../components/WhyUs.astro';
import Faq from '../components/Faq.astro';
import LeadSection from '../components/LeadSection.astro';
import Contacts from '../components/Contacts.astro';
import { models, featuredModels } from '../data/models';
import { companyFaq } from '../data/company';
import { fullName } from '../data/types';
import { site } from '../config/site';
import { absUrl } from '../config/paths';

const cityIn = site.city === 'Махачкала' ? 'Махачкале' : site.city;

const nav = [
  { href: '#models', label: 'Каталог' },
  { href: '#registration', label: 'Учёт РФ/КР' },
  { href: '#credit', label: 'Кредит' },
  { href: '#about', label: 'О нас' },
  { href: '#contacts', label: 'Контакты' },
];

const perks = [
  { title: 'Новые автомобили', text: 'Модели 2025–2026 годов в наличии и под заказ' },
  { title: 'Учёт РФ или КР', text: 'Честно считаем оба варианта' },
  { title: 'Кредит и трейд-ин', text: 'Банки-партнёры, ваш автомобиль в зачёт' },
  { title: 'Тест-драйв', text: `На площадке в ${cityIn}` },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AutoDealer',
    '@id': absUrl('/#dealer', Astro.site),
    name: site.name,
    telephone: site.phone,
    address: {
      '@type': 'PostalAddress',
      addressLocality: site.city,
      addressRegion: site.region,
      streetAddress: site.address,
      addressCountry: 'RU',
    },
    geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lon },
    url: absUrl('/', Astro.site),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Модельный ряд',
    itemListElement: models.map((m, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: fullName(m),
      url: absUrl(`/${m.slug}/`, Astro.site),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: companyFaq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const modelNames = models.map(fullName);
const leadPhoto = featuredModels[0].ctaPhoto ?? featuredModels[0].hero;
---

<Base
  title={`Автомобили из Китая в ${cityIn} — цены, учёт РФ и КР | ${site.name}`}
  description={`${site.name}: новые автомобили из Китая в ${cityIn}. ${modelNames.join(', ')}. Учёт РФ и Кыргызстана, кредит, трейд-ин, тест-драйв.`}
  ogImage={featuredModels[0].hero.src?.src}
  jsonLd={jsonLd}
  nav={nav}
  models={modelNames}
>
  <Showcase models={featuredModels} />

  <section class="perks" aria-label="Преимущества">
    <ul class="container perks__list">
      {
        perks.map((p) => (
          <li>
            <b>{p.title}</b>
            <span>{p.text}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <Catalog
    models={models}
    id="models"
    eyebrow="Модельный ряд"
    title="Выберите свой автомобиль"
    lead="Цены — для учёта в России или в Кыргызстане. Переключите, чтобы сравнить."
  />
  <Registration />
  <Credit models={models} />
  <WhyUs />
  <Faq items={companyFaq} />
  <LeadSection models={modelNames} photo={leadPhoto} title="Приезжайте на тест-драйв" />
  <Contacts />
</Base>

<style>
  .perks {
    background: var(--dark);
    color: var(--on-dark);
    border-top: 1px solid var(--dark-line);
  }

  .perks__list {
    list-style: none;
    margin: 0 auto;
    padding-block: 28px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .perks b {
    display: block;
    font-size: 16px;
    font-weight: 750;
  }

  .perks span {
    display: block;
    margin-top: 4px;
    font-size: 14px;
    color: var(--on-dark-2);
  }

  @media (max-width: 860px) {
    .perks__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
