---
import { registration } from '../data/registration';
---

<section class="reg section" id="registration">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Учёт РФ или КР</span>
      <h2 class="h-section">{registration.title}</h2>
      <p class="lead">{registration.lead}</p>
    </div>

    <div class="reg__grid">
      {
        registration.options.map((o) => (
          <article class="reg__card" data-reveal>
            <p class="reg__tag">{o.tag}</p>
            <h3 class="reg__title">{o.title}</h3>
            <p class="reg__summary">{o.summary}</p>
            <ul class="reg__list">
              {o.points.map((p) => (
                <li class:list={[`is-${p.kind}`]}>{p.text}</li>
              ))}
            </ul>
            <p class="reg__for">
              <b>Кому подходит:</b> {o.forWhom}
            </p>
          </article>
        ))
      }
    </div>

    <div class="reg__cta" data-reveal>
      <p>Не уверены, какой вариант выгоднее именно вам? Посчитаем оба и расскажем про все нюансы оформления.</p>
      <button class="btn" type="button" data-open-lead data-intent="registration">Получить консультацию</button>
    </div>

    <p class="price-note reg__note">{registration.disclaimer}</p>
  </div>
</section>

<style>
  .reg {
    border-top: 1px solid var(--line);
  }

  .reg__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .reg__card {
    display: flex;
    flex-direction: column;
    padding: clamp(28px, 3.4vw, 44px);
    border-radius: 22px;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .reg__tag {
    align-self: flex-start;
    padding: 6px 14px;
    border-radius: 999px;
    background: linear-gradient(180deg, #fdfdfd 0%, #c9ccd1 100%);
    color: #08090b;
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .reg__title {
    margin-top: 24px;
    font-family: var(--font-display);
    font-size: clamp(24px, 2.4vw, 30px);
    font-weight: 600;
  }

  .reg__summary {
    margin-top: 12px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .reg__list {
    list-style: none;
    margin: 28px 0;
    padding: 0;
    display: grid;
    align-content: start;
    gap: 14px;
    flex: 1;
  }

  .reg__list li {
    position: relative;
    padding-left: 34px;
    font-size: 15px;
    line-height: 1.45;
    color: #d7d9dc;
  }

  .reg__list li::before {
    position: absolute;
    left: 0;
    top: 0;
    width: 22px;
    height: 22px;
    box-sizing: border-box;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-weight: 800;
  }

  .reg__list .is-plus::before {
    content: '+';
    background: var(--silver);
    color: #08090b;
    font-size: 15px;
  }

  .reg__list .is-note::before {
    content: '!';
    border: 1.5px solid #8d9199;
    color: var(--ink);
    font-size: 13px;
  }

  .reg__for {
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .reg__for b {
    color: var(--ink);
  }

  .reg__cta {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    padding: clamp(24px, 2.6vw, 30px) clamp(28px, 3.4vw, 44px);
    border-radius: 22px;
    background: linear-gradient(120deg, #1c1e23 0%, var(--surface) 100%);
    border: 1px solid var(--line-2);
  }

  .reg__cta p {
    max-width: 56ch;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.45;
  }

  .reg__note {
    margin-top: 20px;
    max-width: 90ch;
  }

  @media (max-width: 860px) {
    .reg__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
