---
import { site } from '../config/site';
import Logo from './Logo.astro';
import { path } from '../config/paths';

interface Props {
  nav: { href: string; label: string }[];
}
const { nav } = Astro.props;
---

<header class="header" data-header>
  <div class="container header__inner">
    <a href={path('/')} class="header__logo"><Logo /></a>

    <nav class="header__nav" id="site-nav" aria-label="Разделы">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a class="header__nav-phone" href={site.phoneHref}>{site.phone}</a>
    </nav>

    <div class="header__actions">
      <a class="header__phone" href={site.phoneHref}>{site.phone}</a>
      <button class="btn btn--sm" type="button" data-open-lead data-intent="test-drive">Тест-драйв</button>
      {
        nav.length > 0 && (
          <button class="header__burger" type="button" aria-controls="site-nav" aria-expanded="false" data-burger>
            <span class="visually-hidden">Меню</span>
            <i />
            <i />
          </button>
        )
      }
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: var(--demo-h) 0 auto;
    z-index: 50;
    height: var(--header-h);
    color: var(--on-dark);
    --logo-cut: var(--dark);
    transition:
      background-color 0.35s,
      color 0.35s,
      box-shadow 0.35s;
  }

  .header.is-solid {
    background: rgb(255 255 255 / 0.82);
    backdrop-filter: saturate(180%) blur(18px);
    -webkit-backdrop-filter: saturate(180%) blur(18px);
    color: var(--ink);
    --logo-cut: #fff;
    box-shadow: 0 1px 0 var(--line);
  }

  .header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .header__logo {
    text-decoration: none;
    flex-shrink: 0;
  }

  .header__nav {
    display: flex;
    gap: 28px;
    margin-inline: auto;
    font-size: 15px;
    font-weight: 600;
  }

  .header__nav a {
    text-decoration: none;
    opacity: 0.78;
    transition: opacity 0.2s;
  }

  .header__nav a:hover {
    opacity: 1;
  }

  .header__nav-phone {
    display: none;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-left: auto;
  }

  .header__phone {
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    white-space: nowrap;
  }

  .header__burger {
    display: none;
    width: 42px;
    height: 42px;
    border: 0;
    border-radius: 50%;
    background: rgb(127 127 127 / 0.16);
    cursor: pointer;
    position: relative;
  }

  .header__burger i {
    position: absolute;
    left: 13px;
    right: 13px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.3s var(--ease);
  }

  .header__burger i:first-of-type {
    top: 17px;
  }

  .header__burger i:last-of-type {
    top: 23px;
  }

  .header.is-open .header__burger i:first-of-type {
    transform: translateY(3px) rotate(45deg);
  }

  .header.is-open .header__burger i:last-of-type {
    transform: translateY(-3px) rotate(-45deg);
  }

  @media (max-width: 1080px) {
    .header__phone {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .header__burger {
      display: block;
    }

    .header__nav {
      position: fixed;
      inset: calc(var(--header-h) + var(--demo-h)) 0 auto;
      flex-direction: column;
      gap: 0;
      margin: 0;
      padding: 8px var(--gutter) 24px;
      background: #fff;
      color: var(--ink);
      font-size: 20px;
      box-shadow: 0 20px 40px rgb(0 0 0 / 0.12);
      transform: translateY(-8px);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.25s,
        transform 0.3s var(--ease),
        visibility 0.25s;
    }

    .header__nav a {
      padding: 14px 0;
      border-bottom: 1px solid var(--line);
      opacity: 1;
    }

    .header__nav-phone {
      display: block;
      font-weight: 800;
    }

    .header.is-open {
      background: #fff;
      color: var(--ink);
      --logo-cut: #fff;
    }

    .header.is-open .header__nav {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
  }

  @media (max-width: 420px) {
    .header__actions {
      gap: 10px;
    }
  }
</style>
