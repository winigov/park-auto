---
import { site } from '../config/site';
import Logo from './Logo.astro';
import Media from './Media.astro';
import { path } from '../config/paths';
import { models } from '../data/models';
import { energyText } from '../data/types';
import { formatPrice, minPrice } from '../scripts/format';

interface Props {
  nav: { href: string; label: string }[];
}
const { nav } = Astro.props;
---

<header class="header" data-header>
  <div class="container header__inner">
    <a href={path('/')} class="header__logo"><Logo /></a>

    <nav class="header__nav" id="site-nav" aria-label="Разделы">
      <div class="mm" data-mm>
        <button class="mm__btn" type="button" aria-expanded="false" aria-controls="models-menu" data-mm-btn>
          Модели
          <svg viewBox="0 0 12 8" aria-hidden="true"
            ><path d="M1 1.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
            ></path></svg
          >
        </button>
        <div class="mm__panel" id="models-menu" data-mm-panel>
          <div class="container mm__inner">
            <ul class="mm__grid">
              {
                models.map((m) => (
                  <li>
                    <a class="mm__item" href={path(`/${m.slug}/`)}>
                      <span class="mm__img">
                        <Media photo={m.hero} sizes="240px" dark />
                      </span>
                      <span class="mm__text">
                        <span class="mm__brand">{m.brand}</span>
                        <span class="mm__name">{m.name}</span>
                        <span class="mm__meta">
                          {energyText(m)} · от {formatPrice(minPrice(m.trims, 'kg'))}
                        </span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <a class="mm__all" href={path('/#models')}>
              Весь модельный ряд
              <svg viewBox="0 0 16 16" aria-hidden="true"
                ><path
                  d="M3 8h10M9 4l4 4-4 4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              >
            </a>
          </div>
        </div>
      </div>
      {nav.map((item) => <a class="header__link" href={item.href}>{item.label}</a>)}
      <a class="header__nav-phone" href={site.phoneHref}>{site.phone}</a>
    </nav>

    <div class="header__actions">
      <a class="header__phone" href={site.phoneHref}>{site.phone}</a>
      <button class="btn btn--sm" type="button" data-open-lead data-intent="test-drive">Тест-драйв</button>
      <button class="header__burger" type="button" aria-controls="site-nav" aria-expanded="false" data-burger>
        <span class="visually-hidden">Меню</span>
        <i />
        <i />
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: var(--demo-h) 0 auto;
    z-index: 50;
    height: var(--header-h);
    color: var(--ink);
    transition:
      background-color 0.35s,
      box-shadow 0.35s,
      backdrop-filter 0.35s;
  }

  .header.is-solid,
  .header.is-mm-open,
  .header.is-open {
    background: rgb(12 13 16 / 0.9);
    backdrop-filter: saturate(160%) blur(18px);
    -webkit-backdrop-filter: saturate(160%) blur(18px);
    box-shadow: 0 1px 0 var(--line);
  }

  .header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 36px;
  }

  .header__logo {
    flex-shrink: 0;
    text-decoration: none;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 30px;
    margin-left: auto;
    font-size: 15px;
    font-weight: 500;
  }

  .header__link,
  .mm__btn {
    color: rgb(244 244 242 / 0.78);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s;
  }

  .header__link:hover,
  .mm__btn:hover,
  .header.is-mm-open .mm__btn {
    color: #fff;
  }

  .header__nav-phone {
    display: none;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .header__phone {
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .header__burger {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-2);
    border-radius: 50%;
    background: var(--surface-2);
    cursor: pointer;
  }

  .header__burger i {
    position: absolute;
    left: 13px;
    right: 13px;
    height: 2px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform 0.3s var(--ease);
  }

  .header__burger i:first-of-type {
    top: 17px;
  }

  .header__burger i:last-of-type {
    top: 23px;
  }

  .header.is-open .header__burger i:first-of-type {
    transform: translateY(3px) rotate(45deg);
  }

  .header.is-open .header__burger i:last-of-type {
    transform: translateY(-3px) rotate(-45deg);
  }

  /* Меню «Модели» */
  .mm__btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }

  .mm__btn svg {
    width: 10px;
    height: 10px;
    transition: transform 0.3s var(--ease);
  }

  .header.is-mm-open .mm__btn svg {
    transform: rotate(180deg);
  }

  .mm__panel {
    position: fixed;
    inset: calc(var(--demo-h) + var(--header-h)) 0 auto;
    padding: 32px 0 36px;
    background: #101114;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.85);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition:
      opacity 0.25s,
      transform 0.35s var(--ease),
      visibility 0.25s;
  }

  .header.is-mm-open .mm__panel {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .mm__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 24px 20px;
  }

  .mm__item {
    display: grid;
    gap: 14px;
    text-decoration: none;
  }

  .mm__img {
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: 14px;
    overflow: hidden;
    background: var(--surface-3);
    border: 1px solid var(--line);
    transition: border-color 0.3s;
  }

  .mm__img :global(.media) {
    transition: transform 0.6s var(--ease);
  }

  .mm__item:hover .mm__img {
    border-color: var(--silver);
  }

  .mm__item:hover .mm__img :global(.media) {
    transform: scale(1.05);
  }

  .mm__text {
    display: grid;
    gap: 3px;
  }

  .mm__brand {
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .mm__name {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .mm__meta {
    font-size: 13px;
    color: var(--ink-2);
  }

  .mm__all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 26px;
    font-size: 15px;
    font-weight: 700;
    color: var(--silver);
    text-decoration: none;
  }

  .mm__all svg {
    width: 16px;
    height: 16px;
    transition: transform 0.3s var(--ease);
  }

  .mm__all:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 1180px) {
    .header__phone {
      display: none;
    }

    .header__nav {
      gap: 22px;
    }
  }

  @media (max-width: 1080px) and (min-width: 901px) {
    .header__inner {
      gap: 24px;
    }

    .header__nav {
      gap: 16px;
      font-size: 14px;
    }
  }

  @media (max-width: 900px) {
    .header__inner {
      gap: 12px;
    }

    .header__logo :global(.logo) {
      height: 22px;
    }

    .header__actions {
      margin-left: auto;
      gap: 8px;
    }

    .header__actions .btn {
      min-height: 40px;
      padding: 0 16px;
      font-size: 14px;
    }

    .header__burger {
      display: block;
    }

    .header__nav {
      position: fixed;
      inset: calc(var(--header-h) + var(--demo-h)) 0 auto;
      max-height: calc(100dvh - var(--header-h) - var(--demo-h));
      overflow-y: auto;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      margin: 0;
      padding: 20px var(--gutter) 28px;
      background: #101114;
      border-top: 1px solid var(--line);
      font-size: 19px;
      font-weight: 600;
      box-shadow: 0 30px 60px rgb(0 0 0 / 0.6);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition:
        opacity 0.25s,
        transform 0.3s var(--ease),
        visibility 0.25s;
    }

    .header.is-open .header__nav {
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .header__link,
    .header__nav-phone {
      padding: 15px 0;
      border-top: 1px solid var(--line);
      color: var(--ink);
    }

    .header__nav-phone {
      display: block;
      font-weight: 800;
      text-decoration: none;
    }

    .mm__btn {
      display: none;
    }

    .mm::before {
      content: 'Модели';
      display: block;
      margin-bottom: 14px;
      font-family: var(--font-display);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--ink-3);
    }

    .mm__panel {
      position: static;
      padding: 0 0 16px;
      background: none;
      border: 0;
      box-shadow: none;
      opacity: 1;
      /* inherit, не visible: иначе при закрытом меню список моделей остаётся невидимым,
         но кликабельным слоем поверх страницы и перехватывает касания */
      visibility: inherit;
      transform: none;
    }

    .mm__inner {
      padding: 0;
    }

    .mm__grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .mm__item {
      grid-template-columns: 104px 1fr;
      align-items: center;
      gap: 14px;
    }

    .mm__img {
      border-radius: 12px;
    }

    .mm__name {
      font-size: 15px;
    }

    .mm__meta {
      font-size: 12px;
    }

    .mm__all {
      margin-top: 16px;
    }
  }

  @media (max-width: 380px) {
    .header__actions .btn {
      display: none;
    }
  }
</style>
