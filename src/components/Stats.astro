---
import type { Stat } from '../data/types';

interface Props {
  stats: Stat[];
  note?: string;
}
const { stats, note } = Astro.props;
const fmt = (s: Stat) =>
  s.value.toLocaleString('ru-RU', { minimumFractionDigits: s.decimals ?? 0, maximumFractionDigits: s.decimals ?? 0 });
---

<section class="stats section--dark">
  <div class="container">
    <ul class="stats__list">
      {
        stats.map((s) => (
          <li data-reveal>
            <p class="stats__value">
              {s.prefix && <span class="stats__prefix">{s.prefix}</span>}
              <span class="metal-text" data-count={s.value} data-decimals={s.decimals ?? 0}>
                {fmt(s)}
              </span>
              <span class="stats__unit">{s.unit}</span>
            </p>
            <p class="stats__label">{s.label}</p>
          </li>
        ))
      }
    </ul>
    {note && <p class="stats__note">{note}</p>}
  </div>
</section>

<style>
  .stats {
    padding-block: clamp(48px, 6vw, 72px);
    border-top: 1px solid var(--line);
  }

  .stats__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }

  .stats__value {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-family: var(--font-display);
    font-size: clamp(40px, 4.6vw, 64px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .stats__prefix,
  .stats__unit {
    font-family: var(--font);
    font-size: clamp(15px, 1.4vw, 20px);
    font-weight: 700;
    letter-spacing: 0;
    color: var(--ink-2);
  }

  .stats__label {
    margin-top: 14px;
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink-2);
    max-width: 24ch;
  }

  .stats__note {
    margin-top: 40px;
    font-size: 13px;
    color: var(--ink-3);
  }

  @media (max-width: 860px) {
    .stats__list {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px 20px;
    }
  }
</style>
