---
import type { CarModel } from '../data/types';
import { bodyLabels, energiesOf, energyShort } from '../data/types';
import { plural } from '../scripts/format';
import ModelCard from './ModelCard.astro';
import RegSwitch from './RegSwitch.astro';

interface Props {
  models: CarModel[];
  id?: string;
  eyebrow: string;
  title: string;
  lead?: string;
  /** Показывать фильтры (на главной — да, в блоке «Другие модели» — нет) */
  filters?: boolean;
  alt?: boolean;
}
const { models, id = 'models', eyebrow, title, lead, filters = true, alt = false } = Astro.props;

const uniq = <T,>(arr: T[]) => [...new Set(arr)];
const seatsLabel = (g: string) => (g === '6+' ? '6–7' : g);

// Группа фильтра показывается, только если в каталоге есть хотя бы два разных значения
const groups = [
  { key: 'body', label: 'Кузов', values: uniq(models.map((m) => m.body)).map((v) => ({ v, t: bodyLabels[v] })) },
  {
    key: 'seats',
    label: 'Места',
    values: uniq(models.map((m) => (m.seats >= 6 ? '6+' : String(m.seats)))).sort().map((v) => ({ v, t: seatsLabel(v) })),
  },
  { key: 'energy', label: 'Двигатель', values: uniq(models.flatMap(energiesOf)).map((v) => ({ v, t: energyShort[v] })) },
].filter((g) => g.values.length > 1);

const showFilters = filters && groups.length > 0;
const count = (n: number) => `${n} ${plural(n, ['модель', 'модели', 'моделей'])}`;
---

<section class:list={['catalog section reg-scope', { 'section--alt': alt, 'has-dots': !alt }]} id={id} data-catalog>
  <div class="container">
    <div class="catalog__head">
      <div class="section-head" data-reveal>
        <span class="eyebrow">{eyebrow}</span>
        <h2 class="h-section">{title}</h2>
        {lead && <p class="lead">{lead}</p>}
      </div>
      {!showFilters && <RegSwitch name={`reg-${id}`} class="catalog__reg" />}
    </div>

    {
      showFilters && (
        <div class="catalog__bar">
          <div class="catalog__filters" data-filters>
            {groups.map((g) => (
              <label class="fsel" data-group={g.key}>
                <span class="fsel__label">{g.label}</span>
                <span class="fsel__value" data-value-label>
                  Все
                </span>
                <svg class="fsel__chev" viewBox="0 0 12 8" aria-hidden="true">
                  <path d="M1 1.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
                <select aria-label={g.label}>
                  <option value="all">Все</option>
                  {g.values.map(({ v, t }) => (
                    <option value={v}>{t}</option>
                  ))}
                </select>
              </label>
            ))}
            <button type="button" class="catalog__reset" data-reset hidden>
              Сбросить
            </button>
          </div>
          <div class="catalog__side">
            <p class="catalog__count" aria-live="polite" data-count>
              {count(models.length)}
            </p>
            <RegSwitch name={`reg-${id}`} class="catalog__reg catalog__reg--sm" />
          </div>
        </div>
      )
    }

    <div class="catalog__grid">
      {models.map((m) => <ModelCard model={m} />)}
    </div>

    <div class="catalog__empty" data-empty hidden>
      <p>Под эти параметры моделей пока нет. Подберём автомобиль под заказ.</p>
      <div>
        <button type="button" class="btn btn--ghost btn--sm" data-reset>Сбросить фильтры</button>
        <button type="button" class="btn btn--sm" data-open-lead data-intent="price">Подобрать под заказ</button>
      </div>
    </div>
  </div>
</section>

<script>
  import { plural } from '../scripts/format';

  document.querySelectorAll<HTMLElement>('[data-catalog]').forEach((root) => {
    const filters = root.querySelector('[data-filters]');
    if (!filters) return;
    const cards = [...root.querySelectorAll<HTMLElement>('[data-card]')];
    const groups = [...filters.querySelectorAll<HTMLElement>('[data-group]')];
    const state: Record<string, string> = {};
    const countEl = root.querySelector('[data-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const resetBtn = filters.querySelector<HTMLElement>('[data-reset]')!;

    const apply = () => {
      let shown = 0;
      cards.forEach((card) => {
        // у модели может быть несколько значений через пробел (например, data-energy="ice hev")
        const ok = Object.entries(state).every(([k, v]) => v === 'all' || (card.dataset[k] ?? '').split(' ').includes(v));
        card.hidden = !ok;
        if (ok) shown++;
      });
      countEl.textContent = `${shown} ${plural(shown, ['модель', 'модели', 'моделей'])}`;
      empty.hidden = shown > 0;
      resetBtn.hidden = Object.values(state).every((v) => v === 'all');
    };

    // Подпись на кнопке-списке и состояние фильтра — по выбранному пункту
    const sync = (group: HTMLElement) => {
      const select = group.querySelector('select')!;
      state[group.dataset.group!] = select.value;
      group.querySelector('[data-value-label]')!.textContent = select.selectedOptions[0]?.text ?? 'Все';
      group.classList.toggle('is-active', select.value !== 'all');
    };

    groups.forEach((group) => {
      group.querySelector('select')!.addEventListener('change', () => {
        sync(group);
        apply();
      });
      sync(group); // браузер мог восстановить выбор при возврате на страницу
    });
    apply();

    root.querySelectorAll('[data-reset]').forEach((btn) =>
      btn.addEventListener('click', () => {
        groups.forEach((group) => {
          group.querySelector('select')!.value = 'all';
          sync(group);
        });
        apply();
      }),
    );
  });
</script>

<style>
  .catalog__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0 32px;
  }

  .catalog__head :global(.catalog__reg) {
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  /* Фильтр: одна строка — выпадающие списки слева, счётчик и учёт справа */
  .catalog__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin: -12px 0 24px;
  }

  .catalog__filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .fsel {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 40px;
    padding: 0 14px 0 16px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: var(--surface-2);
    font-size: 14px;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }

  .fsel:hover {
    border-color: #3b3e45;
  }

  .fsel.is-active {
    border-color: var(--silver-2);
    background: var(--surface-3);
  }

  .fsel:has(select:focus-visible) {
    outline: 2px solid var(--silver);
    outline-offset: 3px;
  }

  .fsel__label {
    color: var(--ink-3);
    font-weight: 500;
  }

  .fsel__value {
    color: var(--ink);
    font-weight: 600;
  }

  .fsel__chev {
    width: 10px;
    height: 10px;
    margin-left: 2px;
    color: var(--ink-3);
  }

  /* Сам список прозрачный поверх кнопки: по нажатию открывается системный выбор.
     16px — чтобы iPhone не увеличивал страницу при открытии */
  .fsel select {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    font-size: 16px;
    cursor: pointer;
  }

  .catalog__reset {
    height: 40px;
    padding: 0 8px;
    border: 0;
    background: none;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-2);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .catalog__reset:hover {
    color: var(--ink);
  }

  .catalog__reset[hidden] {
    display: none;
  }

  .catalog__side {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-left: auto;
  }

  .catalog__count {
    font-size: 14px;
    color: var(--ink-3);
    white-space: nowrap;
  }

  /* Переключатель учёта в строке фильтра — той же высоты, что и списки */
  .catalog__side :global(.reg-switch) {
    padding: 3px;
  }

  .catalog__side :global(.reg-switch span) {
    padding: 9px 16px;
    font-size: 14px;
    line-height: 1;
  }

  .catalog {
    border-top: 1px solid var(--line);
  }

  .catalog__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 16px;
  }

  .catalog__empty {
    display: grid;
    justify-items: center;
    gap: 16px;
    padding: 48px 24px;
    border: 1.5px dashed var(--line-2);
    border-radius: var(--radius);
    text-align: center;
    color: var(--ink-2);
  }

  .catalog__empty[hidden] {
    display: none;
  }

  .catalog__empty div {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }

  @media (max-width: 720px) {
    .catalog__bar {
      gap: 10px;
      margin-top: -20px;
    }

    /* На телефоне: сверху учёт и счётчик, под ними списки */
    .catalog__side {
      order: -1;
      width: 100%;
      justify-content: space-between;
      margin-left: 0;
    }

    .catalog__count {
      order: 1;
    }

    .catalog__filters {
      gap: 6px;
    }

    .catalog__filters {
      gap: 6px;
    }

    .fsel {
      height: 38px;
      padding: 0 10px 0 13px;
    }

    /* На узком экране — одно слово: название фильтра, а после выбора — значение */
    .fsel:not(.is-active) .fsel__value,
    .fsel.is-active .fsel__label {
      display: none;
    }

    .fsel__label {
      color: var(--ink);
      font-weight: 600;
    }
  }
</style>
