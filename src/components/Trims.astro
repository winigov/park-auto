---
import type { Trim } from '../data/types';
import { formatPrice } from '../scripts/format';
import RegSwitch from './RegSwitch.astro';

interface Props {
  trims: Trim[];
  colors: { name: string; hex: string }[];
}
const { trims, colors } = Astro.props;
---

<section class="trims section section--alt reg-scope" id="trims">
  <div class="container">
    <div class="trims__head">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Комплектации и цены</span>
        <h2 class="h-section">Выберите свою версию</h2>
        <p class="lead">Цены зависят от того, на каком учёте вы берёте автомобиль. Разницу объясняем ниже.</p>
      </div>

      <RegSwitch name="reg-trims" class="trims__reg" />
    </div>

    <ul class="trims__grid">
      {
        trims.map((t) => (
          <li class:list={['trim', { 'trim--popular': t.popular }]} data-reveal>
            {t.popular && <span class="trim__flag">Выбор покупателей</span>}
            <h3 class="trim__name">{t.name}</h3>
            <p class="trim__sub">{t.subtitle}</p>
            <p class="trim__price">
              <span class="price-rf">{formatPrice(t.prices.rf)}</span>
              <span class="price-kg">{formatPrice(t.prices.kg)}</span>
            </p>
            <ul class="trim__features check-list">
              {t.features.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
            <button
              class:list={['btn btn--block', { 'btn--ghost': !t.popular }]}
              type="button"
              data-open-lead
              data-intent="price"
              data-trim={t.id}
            >
              Получить предложение
            </button>
          </li>
        ))
      }
    </ul>

    <div class="trims__colors" data-reveal>
      <p class="trims__colors-title">Цвета кузова</p>
      <ul>
        {
          colors.map((c) => (
            <li>
              <span class="swatch" style={`--c:${c.hex}`} />
              {c.name}
            </li>
          ))
        }
      </ul>
    </div>

    <p class="price-note trims__note">
      Цены предварительные и носят информационный характер, не являются публичной офертой. Точную стоимость
      и наличие уточняйте у менеджера.
    </p>
  </div>
</section>

<style>
  .trims {
    border-top: 1px solid var(--line);
  }

  .trims__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0 32px;
  }

  .trims__head :global(.trims__reg) {
    margin-bottom: clamp(40px, 5vw, 56px);
  }

  .trims__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .trims__grid:has(> :nth-child(2):last-child) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .trims__grid:has(> :nth-child(3):last-child) {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 1180px) {
    .trims__grid,
    .trims__grid:has(> :nth-child(3):last-child) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 28px;
    }
  }

  @media (max-width: 640px) {
    .trims__grid,
    .trims__grid:has(> :nth-child(2):last-child),
    .trims__grid:has(> :nth-child(3):last-child) {
      grid-template-columns: 1fr;
    }
  }

  .trim {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 32px 28px 28px;
    border-radius: 22px;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .trim--popular {
    border-color: var(--silver);
    box-shadow: 0 30px 70px -40px rgb(233 235 238 / 0.45);
  }

  .trim__flag {
    position: absolute;
    top: -13px;
    left: 26px;
    padding: 5px 12px;
    border-radius: 999px;
    background: linear-gradient(180deg, #fdfdfd 0%, #c9ccd1 100%);
    color: #08090b;
    font-size: 12px;
    font-weight: 700;
  }

  .trim__name {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .trim__sub {
    margin-top: 6px;
    color: var(--ink-2);
    font-size: 14px;
  }

  .trim__price {
    margin: 24px 0;
    font-size: clamp(26px, 2.3vw, 32px);
    font-weight: 800;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .trim__features {
    flex: 1;
    margin: 0 0 28px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .trims__colors {
    margin-top: 48px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }

  .trims__colors-title {
    font-weight: 700;
  }

  .trims__colors ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    font-size: 14px;
    color: var(--ink-2);
  }

  .trims__colors li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .swatch {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--c);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.18),
      inset 0 6px 8px rgb(255 255 255 / 0.15);
  }

  .trims__note {
    margin-top: 28px;
    max-width: 70ch;
  }
</style>
