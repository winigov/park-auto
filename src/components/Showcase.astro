---
import type { CarModel } from '../data/types';
import { energyText, fullName } from '../data/types';
import { site } from '../config/site';
import { path } from '../config/paths';
import { formatPrice, minPrice } from '../scripts/format';
import Media from './Media.astro';

interface Props {
  models: CarModel[];
}
const { models } = Astro.props;
const multi = models.length > 1;
---

<section class:list={['showcase', { 'showcase--single': !multi }]} data-showcase data-hero aria-roledescription="карусель" aria-label="Модели в наличии">
  <h1 class="visually-hidden">
    {site.name} — новые автомобили из Китая в {site.city === 'Махачкала' ? 'Махачкале' : site.city} на учёте РФ и КР
  </h1>

  {
    models.map((m, i) => (
      <article
        class:list={['slide', { 'is-active': i === 0 }]}
        data-slide={i}
        aria-roledescription="слайд"
        aria-label={`${i + 1} из ${models.length}: ${fullName(m)}`}
        aria-hidden={i === 0 ? undefined : 'true'}
      >
        <div
          class:list={['slide__bg', { 'slide__bg--offset': m.heroOffset }]}
          style={m.heroOffset ? `--hero-offset:${m.heroOffset}%` : undefined}
        >
          <Media photo={m.hero} priority={i === 0} eager dark />
        </div>
        <div class="slide__shade" />

        <div class="container slide__top">
          <p class="slide__brand">{m.brand}</p>
          <h2 class="h-display slide__name">{m.name}</h2>
          <p class="slide__tagline">{m.tagline}</p>
        </div>

        <div class="container slide__bottom">
          <dl class="slide__prices">
            <div>
              <dt>На учёте РФ</dt>
              <dd>от {formatPrice(minPrice(m.trims, 'rf'))}</dd>
            </div>
            <div>
              <dt>На учёте КР</dt>
              <dd>от {formatPrice(minPrice(m.trims, 'kg'))}</dd>
            </div>
          </dl>
          <div class="slide__cta">
            <a class="btn" href={path(`/${m.slug}/`)} tabindex={i === 0 ? undefined : -1}>
              Подробнее о модели
            </a>
            <button
              class="btn btn--ghost"
              type="button"
              data-open-lead
              data-intent="test-drive"
              data-model={fullName(m)}
              tabindex={i === 0 ? undefined : -1}
            >
              Тест-драйв
            </button>
          </div>
        </div>
      </article>
    ))
  }

  {
    multi && (
      <div class="container showcase__tabs" role="tablist" aria-label="Выбор модели">
        {models.map((m, i) => (
          <button
            type="button"
            role="tab"
            class:list={['tab', { 'is-active': i === 0 }]}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-tab={i}
          >
            <span class="tab__bar">
              <i />
            </span>
            <span class="tab__name">
              {m.brand} <b>{m.name}</b>
            </span>
            <span class="tab__meta">{energyText(m)}</span>
          </button>
        ))}
      </div>
    )
  }
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-showcase]');
  const slides = root ? [...root.querySelectorAll<HTMLElement>('[data-slide]')] : [];
  const tabs = root ? [...root.querySelectorAll<HTMLElement>('[data-tab]')] : [];

  if (root && slides.length > 1) {
    // При «Уменьшить движение» витрина тоже листается, но реже и простым затуханием (приближение фото отключено в CSS)
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DURATION = reduce ? 10000 : 7000;
    let current = 0;
    let paused = false;
    let visible = true;

    root.style.setProperty('--duration', `${DURATION}ms`);

    const go = (next: number) => {
      current = (next + slides.length) % slides.length;
      slides.forEach((s, i) => {
        const on = i === current;
        s.classList.toggle('is-active', on);
        s.toggleAttribute('aria-hidden', !on);
        s.querySelectorAll<HTMLElement>('a, button').forEach((el) => (on ? el.removeAttribute('tabindex') : (el.tabIndex = -1)));
      });
      tabs.forEach((t, i) => {
        t.classList.toggle('is-active', i === current);
        t.setAttribute('aria-selected', String(i === current));
        // перезапуск анимации полосы прогресса
        const bar = t.querySelector('i')!;
        bar.style.animation = 'none';
        void bar.offsetWidth;
        bar.style.animation = '';
      });
    };

    const sync = () => root.classList.toggle('is-paused', paused || !visible || document.hidden);

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => go(i));
      t.querySelector('i')!.addEventListener('animationend', () => {
        if (i === current) go(current + 1);
      });
    });

    // Пауза, только пока курсор над вкладками: витрина на весь экран, и пауза по наведению на неё целиком
    // останавливала бы прокрутку почти всегда
    const tabsBox = root.querySelector<HTMLElement>('.showcase__tabs');
    tabsBox?.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse') (paused = true), sync();
    });
    tabsBox?.addEventListener('pointerleave', () => ((paused = false), sync()));
    // и при навигации с клавиатуры; клик мышью по вкладке паузу не включает
    root.addEventListener('focusin', (e) => {
      if ((e.target as HTMLElement).matches(':focus-visible')) (paused = true), sync();
    });
    root.addEventListener('focusout', () => ((paused = false), sync()));
    document.addEventListener('visibilitychange', sync);
    new IntersectionObserver(([e]) => ((visible = e.isIntersecting), sync()), { threshold: 0.3 }).observe(root);

    // свайп на телефоне
    let x0: number | null = null;
    root.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    root.addEventListener(
      'touchend',
      (e) => {
        if (x0 === null) return;
        const dx = e.changedTouches[0].clientX - x0;
        if (Math.abs(dx) > 50) go(current + (dx < 0 ? 1 : -1));
        x0 = null;
      },
      { passive: true },
    );

    sync();
  }
</script>

<style>
  .showcase {
    position: relative;
    height: 100svh;
    min-height: 620px;
    overflow: hidden;
    overflow: clip; /* обрезает, но не делает блок прокручиваемым */
    background: var(--dark);
    color: var(--on-dark);
    isolation: isolate;
  }

  .slide {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-bottom: 96px;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.9s var(--ease),
      visibility 0s 0.9s;
  }

  .slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.9s var(--ease);
    z-index: 1;
  }

  .slide__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    transform: scale(1.08);
    transition: transform 2.4s var(--ease);
  }

  .slide.is-active .slide__bg {
    transform: none;
  }

  .slide__bg--offset {
    top: var(--hero-offset);
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 22%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 22%);
  }

  .slide__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(8 9 11 / 0.72) 0%, rgb(8 9 11 / 0.35) 24%, rgb(8 9 11 / 0) 46%),
      linear-gradient(0deg, rgb(8 9 11 / 0.92) 0%, rgb(8 9 11 / 0.35) 26%, rgb(8 9 11 / 0) 45%);
  }

  .slide__top {
    padding-top: calc(var(--header-h) + clamp(28px, 6vh, 64px));
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .slide__top > *,
  .slide__bottom {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.8s var(--ease),
      transform 1s var(--ease);
  }

  .slide.is-active .slide__top > *,
  .slide.is-active .slide__bottom {
    opacity: 1;
    transform: none;
  }

  .slide.is-active .slide__top > :nth-child(2) {
    transition-delay: 0.08s;
  }

  .slide.is-active .slide__top > :nth-child(3) {
    transition-delay: 0.16s;
  }

  .slide.is-active .slide__bottom {
    transition-delay: 0.24s;
  }

  .slide__brand {
    font-size: clamp(14px, 1.3vw, 17px);
    font-weight: 700;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.75);
    margin-bottom: 6px;
  }

  .slide__name {
    font-size: clamp(56px, 10vw, 150px);
    text-shadow: 0 4px 40px rgb(0 0 0 / 0.25);
  }

  .slide__tagline {
    margin-top: 14px;
    font-size: clamp(18px, 2vw, 26px);
    font-weight: 500;
    max-width: 34ch;
    color: rgb(255 255 255 / 0.9);
  }

  .slide__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 40px;
  }

  .slide__prices {
    display: flex;
    gap: clamp(24px, 4vw, 56px);
    margin: 0;
  }

  .slide__prices dt {
    font-size: 14px;
    color: var(--on-dark-2);
    margin-bottom: 4px;
  }

  .slide__prices dd {
    margin: 0;
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 750;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .slide__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .showcase--single .slide {
    padding-bottom: clamp(28px, 5vh, 56px);
  }

  /* Вкладки моделей */
  .showcase__tabs {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    gap: 8px;
    padding-bottom: 20px;
  }

  .tab {
    flex: 1 1 0;
    min-width: 0;
    display: grid;
    gap: 2px;
    padding: 0 0 4px;
    border: 0;
    background: none;
    color: rgb(255 255 255 / 0.55);
    text-align: left;
    cursor: pointer;
    transition: color 0.3s;
  }

  .tab:hover,
  .tab.is-active {
    color: #fff;
  }

  .tab__bar {
    height: 3px;
    margin-bottom: 12px;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.22);
    overflow: hidden;
  }

  .tab__bar i {
    display: block;
    height: 100%;
    width: 100%;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
  }

  .tab.is-active .tab__bar i {
    animation: tab-progress var(--duration, 7000ms) linear forwards;
  }

  .showcase.is-paused .tab.is-active .tab__bar i {
    animation-play-state: paused;
  }

  @keyframes tab-progress {
    to {
      transform: scaleX(1);
    }
  }

  .tab__name {
    font-size: 15px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tab__meta {
    font-size: 12.5px;
    opacity: 0.7;
  }

  /* Телефон: фото полосой посередине, чтобы машина не обрезалась */
  @media (max-width: 720px) and (orientation: portrait) {
    .slide__bg {
      inset: 30% 0 auto;
      height: 42%;
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 22%, #000 70%, transparent 100%);
      mask-image: linear-gradient(180deg, transparent 0%, #000 22%, #000 70%, transparent 100%);
    }

    .slide__shade {
      display: none;
    }

    .showcase {
      background:
        radial-gradient(120% 40% at 50% 8%, #1d2b45 0%, transparent 70%),
        linear-gradient(180deg, #0c1220 0%, var(--dark) 70%);
    }
  }

  @media (max-width: 720px) {
    .slide {
      padding-bottom: 88px;
    }

    .slide__prices {
      width: 100%;
      justify-content: space-between;
    }

    .slide__cta {
      width: 100%;
    }

    .slide__cta .btn {
      flex: 1 1 100%;
    }

    .showcase__tabs {
      overflow-x: auto;
      scrollbar-width: none;
    }

    .showcase__tabs::-webkit-scrollbar {
      display: none;
    }

    .tab {
      flex: 0 0 44%;
    }

    .tab__meta {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide__bg,
    .slide__top > *,
    .slide__bottom {
      transition: none;
    }
  }
</style>
