---
// Фирменный логотип «Парк Авто»: хромовый знак и надпись (исходник — brand/logo)
import { Image } from 'astro:assets';
import lockup from '../assets/brand/lockup.png';

interface Props {
  class?: string;
  /** Высота логотипа, px */
  height?: number;
}
const { class: className, height = 30 } = Astro.props;
---

<Image
  src={lockup}
  alt="Парк Авто"
  height={height}
  densities={[1, 2]}
  loading="eager"
  class:list={['logo', className]}
  style={`--logo-h:${height}px`}
/>

<style>
  .logo {
    display: block;
    height: var(--logo-h);
    width: auto;
  }
</style>
