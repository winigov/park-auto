---
// TODO: заменить на фирменный логотип «Парк Авто» (SVG)
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['logo', className]} aria-label="Парк Авто">
  <svg viewBox="0 0 28 28" aria-hidden="true">
    <rect width="28" height="28" rx="8" fill="currentColor"></rect>
    <path d="M9 21V7h6.2a4.6 4.6 0 0 1 0 9.2H9" fill="none" stroke="var(--logo-cut, #08090b)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <span class="logo__text">Парк<b>Авто</b></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 19px;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .logo svg {
    width: 28px;
    height: 28px;
  }

  .logo b {
    font-weight: 800;
    margin-left: 2px;
  }
</style>
