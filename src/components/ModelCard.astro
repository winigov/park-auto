---
import type { CarModel } from '../data/types';
import { bodyLabels, energiesOf, energyText, fullName } from '../data/types';
import { path } from '../config/paths';
import { formatPrice, minPrice, plural } from '../scripts/format';
import Media from './Media.astro';

interface Props {
  model: CarModel;
}
const { model: m } = Astro.props;
const href = path(`/${m.slug}/`);
const seats = `${m.seats} ${plural(m.seats, ['место', 'места', 'мест'])}`;
const seatsGroup = m.seats >= 6 ? '6+' : String(m.seats);
---

<article class="mc" data-card data-body={m.body} data-energy={energiesOf(m).join(' ')} data-seats={seatsGroup}>
  <a class="mc__img" href={href} tabindex="-1" aria-hidden="true">
    <Media photo={m.hero} sizes="(max-width: 720px) 100vw, (max-width: 1100px) 50vw, 400px" dark />
  </a>
  <div class="mc__badges">
    {m.isNew && <span class="mc__badge mc__badge--new">Новинка</span>}
    <span class:list={['mc__badge', { 'mc__badge--stock': m.availability === 'in-stock' }]}>
      {m.availability === 'in-stock' ? 'В наличии' : 'Под заказ'}
    </span>
  </div>

  <div class="mc__body">
    <p class="mc__meta">{bodyLabels[m.body]} · {energyText(m)} · {seats}</p>
    <h3 class="mc__name">
      <a href={href}>
        <span class="mc__brand">{m.brand}</span>
        {m.name}
      </a>
    </h3>

    <ul class="mc__hl">
      {
        m.highlights.slice(0, 3).map((h) => (
          <li>
            <b>{h.value}</b>
            <span>{h.label}</span>
          </li>
        ))
      }
    </ul>

    <div class="mc__foot">
      <p class="mc__price">
        <span class="mc__from">от</span>
        <span class="price-rf">{formatPrice(minPrice(m.trims, 'rf'))}</span>
        <span class="price-kg">{formatPrice(minPrice(m.trims, 'kg'))}</span>
      </p>
      <div class="mc__actions">
        <a class="btn btn--sm" href={href}>Подробнее</a>
        <button
          class="btn btn--sm btn--ghost"
          type="button"
          data-open-lead
          data-intent="test-drive"
          data-model={fullName(m)}
        >
          Тест-драйв
        </button>
      </div>
    </div>
  </div>
</article>

<style>
  .mc {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
    transition:
      border-color 0.4s,
      box-shadow 0.4s var(--ease),
      transform 0.4s var(--ease);
  }

  .mc:hover {
    border-color: #3a3d44;
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.8);
    transform: translateY(-4px);
  }

  .mc[hidden] {
    display: none;
  }

  .mc__img {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--surface-3);
  }

  .mc__img :global(.media) {
    transition: transform 0.9s var(--ease);
  }

  .mc:hover .mc__img :global(.media) {
    transform: scale(1.05);
  }

  .mc__badges {
    position: absolute;
    top: 14px;
    left: 14px;
    display: flex;
    gap: 6px;
    pointer-events: none;
  }

  .mc__badge {
    padding: 5px 10px;
    border-radius: 999px;
    background: rgb(8 9 11 / 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-size: 11px;
    font-weight: 600;
    color: var(--ink);
  }

  .mc__badge--new {
    background: linear-gradient(180deg, #fdfdfd 0%, #c9ccd1 100%);
    color: #08090b;
    font-weight: 700;
  }

  .mc__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 20px 22px 22px;
  }

  .mc__meta {
    font-size: 12.5px;
    color: var(--ink-3);
  }

  .mc__name {
    margin-top: 10px;
    font-family: var(--font-display);
    font-size: clamp(20px, 1.7vw, 23px);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .mc__name a {
    text-decoration: none;
  }

  .mc__name a::after {
    /* вся картинка кликабельна через заголовок */
    content: '';
    position: absolute;
    inset: 0 0 auto;
    aspect-ratio: 16 / 10;
  }

  .mc__brand {
    display: block;
    margin-bottom: 4px;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.26em;
    color: var(--silver-2);
  }

  .mc__hl {
    list-style: none;
    margin: 16px 0 18px;
    padding: 14px 0 0;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .mc__hl b {
    display: block;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .mc__hl span {
    display: block;
    margin-top: 2px;
    font-size: 12px;
    line-height: 1.3;
    color: var(--ink-3);
  }

  .mc__foot {
    margin-top: auto;
    display: grid;
    gap: 16px;
  }

  .mc__price {
    font-size: 21px;
    font-weight: 800;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .mc__from {
    margin-right: 4px;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-3);
  }

  .mc__actions {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .mc__actions .btn {
    padding: 0 12px;
  }
</style>
