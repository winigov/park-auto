---
import { site } from '../config/site';
const { lat, lon } = site.geo;
const mapSrc = `https://yandex.ru/map-widget/v1/?ll=${lon}%2C${lat}&z=13&pt=${lon}%2C${lat}%2Cpm2blm`;
---

<section class="contacts section" id="contacts">
  <div class="container contacts__grid">
    <div class="contacts__info" data-reveal>
      <span class="eyebrow">Контакты</span>
      <h2 class="h-section">Приезжайте в шоурум</h2>
      <dl>
        <div>
          <dt>Адрес</dt>
          <dd>{site.address}</dd>
        </div>
        <div>
          <dt>Режим работы</dt>
          <dd>{site.hours}</dd>
        </div>
        <div>
          <dt>Телефон</dt>
          <dd><a href={site.phoneHref}>{site.phone}</a></dd>
        </div>
      </dl>
      <div class="contacts__actions">
        <a class="btn" href={site.whatsapp} target="_blank" rel="noopener">Написать в WhatsApp</a>
        <a class="btn btn--ghost" href={site.telegram} target="_blank" rel="noopener">Telegram</a>
      </div>
    </div>
    <div class="contacts__map" data-reveal>
      <iframe src={mapSrc} title={`${site.name} на карте`} loading="lazy" allowfullscreen></iframe>
    </div>
  </div>
</section>

<style>
  .contacts__grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: stretch;
  }

  .contacts__info h2 {
    margin-bottom: 36px;
  }

  .contacts dl {
    margin: 0 0 36px;
    display: grid;
    gap: 20px;
  }

  .contacts dt {
    font-size: 14px;
    color: var(--ink-3);
  }

  .contacts dd {
    margin: 2px 0 0;
    font-size: 20px;
    font-weight: 700;
  }

  .contacts dd a {
    text-decoration: none;
  }

  .contacts__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .contacts__map {
    min-height: 420px;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-alt);
  }

  .contacts__map iframe {
    width: 100%;
    height: 100%;
    min-height: 420px;
    border: 0;
    display: block;
  }

  @media (max-width: 900px) {
    .contacts__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
