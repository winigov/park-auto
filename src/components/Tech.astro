---
import type { CarModel } from '../data/types';

interface Props {
  tech: NonNullable<CarModel['tech']>;
}
const { tech } = Astro.props;
---

<section class="tech section section--alt has-dots" id="tech">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Технологии</span>
      <h2 class="h-section">{tech.title}</h2>
      <p class="lead">{tech.text}</p>
    </div>

    <ul class="tech__grid">
      {
        tech.points.map((p) => (
          <li class="tech__card" data-reveal>
            <p class="tech__value metal-text">{p.value}</p>
            <p class="tech__label">{p.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .tech {
    border-top: 1px solid var(--line);
  }

  .tech__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .tech__card {
    padding: clamp(24px, 2.6vw, 32px);
    border-radius: var(--radius);
    background: linear-gradient(160deg, #17191e 0%, #111215 100%);
    border: 1px solid var(--line);
    min-height: 190px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
  }

  .tech__value {
    font-family: var(--font-display);
    font-size: clamp(28px, 2.8vw, 36px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .tech__label {
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.45;
  }

  @media (max-width: 960px) {
    .tech__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .tech__grid {
      grid-template-columns: 1fr;
    }

    .tech__card {
      min-height: 0;
    }
  }
</style>
