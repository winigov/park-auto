---
import type { Chapter } from '../data/types';
import Media from './Media.astro';

interface Props {
  chapters: Chapter[];
}
const { chapters } = Astro.props;
---

<section class="story" id="story" data-story>
  <div class="container story__grid">
    <div class="story__visual" aria-hidden="true">
      <div class="story__frame">
        {
          chapters.map((c, i) => (
            <div class:list={['story__img', { 'is-active': i === 0 }]} data-story-img={i}>
              <Media photo={c.photo} sizes="(max-width: 900px) 100vw, 60vw" />
            </div>
          ))
        }
      </div>
    </div>

    <div class="story__steps">
      {
        chapters.map((c, i) => (
          <article class="story__step" data-story-step={i}>
            <div class="story__img-mobile">
              <Media photo={c.photo} sizes="100vw" />
            </div>
            <span class="eyebrow">{c.eyebrow}</span>
            <h2 class="h-section">{c.title}</h2>
            <p class="lead">{c.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .story {
    padding-block: clamp(72px, 10vw, 140px);
  }

  .story__grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: clamp(32px, 5vw, 80px);
  }

  .story__visual {
    position: relative;
  }

  .story__frame {
    position: sticky;
    top: calc(var(--header-h) + var(--demo-h) + 5vh);
    height: calc(90vh - var(--header-h));
    max-height: 760px;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-alt);
  }

  .story__img {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.06);
    transition:
      opacity 0.8s var(--ease),
      transform 1.2s var(--ease);
  }

  .story__img.is-active {
    opacity: 1;
    transform: none;
  }

  .story__step {
    min-height: 90vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
  }

  .story__step h2 {
    margin-bottom: 20px;
    font-size: clamp(32px, 3.8vw, 54px);
  }

  .story__img-mobile {
    display: none;
  }

  @media (max-width: 900px) {
    .story__grid {
      grid-template-columns: 1fr;
    }

    .story__visual {
      display: none;
    }

    .story__step {
      min-height: 0;
      padding-bottom: 64px;
    }

    .story__img-mobile {
      display: block;
      aspect-ratio: 4 / 3;
      border-radius: var(--radius);
      overflow: hidden;
      margin-bottom: 28px;
    }
  }
</style>
