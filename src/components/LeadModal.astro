---
import LeadForm from './LeadForm.astro';

interface Props {
  model: string;
  models: string[];
  trims: { id: string; name: string }[];
}
const { model, models, trims } = Astro.props;
---

<dialog class="lead-modal" data-lead-modal aria-labelledby="lead-modal-title">
  <div class="lead-modal__box">
    <button class="lead-modal__close" type="button" data-close-lead aria-label="Закрыть">
      <svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
    </button>
    <p class="eyebrow" data-lead-eyebrow data-default={model || 'Парк Авто'}>{model || 'Парк Авто'}</p>
    <h2 class="lead-modal__title" id="lead-modal-title" data-lead-title>Записаться на тест-драйв</h2>
    <p class="lead-modal__text" data-lead-text>Оставьте телефон — подберём удобное время и подготовим автомобиль.</p>
    <LeadForm id="modal" model={model} models={models} trims={trims} />
  </div>
</dialog>

<style>
  .lead-modal {
    width: min(500px, calc(100% - 24px));
    max-height: calc(100dvh - 24px);
    padding: 0;
    border: 1px solid var(--line-2);
    border-radius: 26px;
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 50px 120px rgb(0 0 0 / 0.7);
    overflow: auto;
  }

  .lead-modal::backdrop {
    background: rgb(8 9 11 / 0.74);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .lead-modal[open] {
    animation: modal-in 0.35s var(--ease);
  }

  @keyframes modal-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.98);
    }
  }

  .lead-modal__box {
    position: relative;
    padding: clamp(28px, 5vw, 40px);
    background: var(--surface);
  }

  .lead-modal__close {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: #1d1f24;
    color: var(--ink);
    cursor: pointer;
  }

  .lead-modal__close:hover {
    background: #26282d;
  }

  .lead-modal__close svg {
    width: 18px;
    height: 18px;
  }

  .lead-modal__title {
    padding-right: 40px;
    font-family: var(--font-display);
    font-size: clamp(21px, 3vw, 26px);
    font-weight: 600;
    line-height: 1.2;
  }

  .lead-modal__text {
    margin: 12px 0 24px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .lead-modal .eyebrow {
    margin-bottom: 12px;
    font-size: 11px;
    letter-spacing: 0.28em;
  }
</style>
