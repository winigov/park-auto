---
import type { CarModel } from '../data/types';

interface Props {
  specs: CarModel['specs'];
  name: string;
  note: string;
}
const { specs, name, note } = Astro.props;
const [first, ...rest] = specs;
---

<section class="specs section" id="specs">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Характеристики</span>
      <h2 class="h-section">Технические характеристики {name}</h2>
    </div>

    <div class="specs__group" data-reveal>
      <h3 class="specs__title">{first.group}</h3>
      <dl>
        {
          first.items.map((s) => (
            <div>
              <dt>{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    {
      rest.map((g) => (
        <details class="specs__more">
          <summary>
            <span class="specs__title">{g.group}</span>
            <span class="specs__icon" aria-hidden="true" />
          </summary>
          <dl>
            {g.items.map((s) => (
              <div>
                <dt>{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))}
          </dl>
        </details>
      ))
    }
    <p class="price-note specs__note">{note}</p>
  </div>
</section>

<style>
  .specs__group {
    display: grid;
    grid-template-columns: minmax(200px, 280px) minmax(0, 1fr);
    gap: 24px 48px;
    padding: 36px 0;
    border-top: 1px solid var(--line-2);
  }

  .specs__title {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
  }

  .specs dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px 32px;
  }

  .specs dt {
    margin-bottom: 6px;
    font-size: 13px;
    color: var(--ink-3);
  }

  .specs dd {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.35;
  }

  .specs__more {
    border-top: 1px solid var(--line-2);
  }

  .specs__more summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 72px;
    list-style: none;
    cursor: pointer;
  }

  .specs__more summary::-webkit-details-marker {
    display: none;
  }

  .specs__more dl {
    padding: 8px 0 36px;
  }

  @media (min-width: 861px) {
    /* раскрытая группа — той же колонкой, что «Основное» */
    .specs__more dl {
      margin-left: calc(280px + 48px);
    }
  }

  .specs__icon {
    flex-shrink: 0;
    position: relative;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid #33363c;
    transition:
      background-color 0.3s,
      border-color 0.3s;
  }

  .specs__icon::before,
  .specs__icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 2px;
    margin: -1px 0 0 -6px;
    border-radius: 2px;
    background: var(--ink);
    transition:
      transform 0.3s var(--ease),
      background-color 0.3s;
  }

  .specs__icon::after {
    transform: rotate(90deg);
  }

  .specs__more summary:hover .specs__icon {
    border-color: var(--silver-2);
  }

  .specs__more[open] .specs__icon {
    border-color: transparent;
    background: var(--metal);
  }

  .specs__more[open] .specs__icon::before,
  .specs__more[open] .specs__icon::after {
    background: #08090b;
  }

  .specs__more[open] .specs__icon::after {
    transform: rotate(0deg);
  }

  .specs__note {
    margin-top: 0;
    padding-top: 24px;
    border-top: 1px solid var(--line-2);
    max-width: 90ch;
  }

  @media (max-width: 1080px) {
    .specs dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .specs__group {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .specs dl {
      gap: 20px 16px;
    }

    .specs dd {
      font-size: 15px;
    }
  }
</style>
