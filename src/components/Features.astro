---
import type { Feature } from '../data/types';
import Media from './Media.astro';

interface Props {
  features: Feature[];
  title: string;
  lead?: string;
  note?: string;
}
const { features, title, lead, note } = Astro.props;
---

<section class="features section" id="features">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Возможности</span>
      <h2 class="h-section">{title}</h2>
      {lead && <p class="lead">{lead}</p>}
    </div>

    <ul class="features__grid">
      {
        features.map((f) => (
          <li class:list={['feat', { 'feat--wide': f.size === 'wide' }]} data-reveal>
            <div class="feat__img">
              <Media
                photo={f.photo}
                need={f.size === 'wide' ? 1400 : 700}
                sizes={
                  f.size === 'wide'
                    ? '(max-width: 720px) 86vw, (max-width: 1100px) 100vw, 850px'
                    : '(max-width: 720px) 86vw, (max-width: 1100px) 50vw, 420px'
                }
              />
            </div>
            <div class="feat__text">
              <h3 class="feat__title">{f.title}</h3>
              <p>{f.text}</p>
            </div>
          </li>
        ))
      }
    </ul>

    {note && <p class="price-note features__note">{note}</p>}
  </div>
</section>

<style>
  /*
   * Фото — полосой сверху, текст — под ним, а не фото на всю карточку.
   * Высота полосы ≈ ширина обычной карточки / 2,2: так даже фото 785×320 px
   * показывается почти в своём размере и не растягивается.
   */
  .features {
    border-top: 1px solid var(--line);
  }

  .features__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-flow: row dense;
    gap: 16px;
    container-type: inline-size;
    --img-h: calc((100cqw - 32px) / 3 / 2.2);
  }

  .feat {
    display: flex;
    flex-direction: column;
    border-radius: 22px;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .feat--wide {
    grid-column: span 2;
  }

  .feat__img {
    position: relative;
    height: var(--img-h);
    overflow: hidden;
    background: var(--surface-3);
  }

  /* Фото не влияет на высоту карточки — её задаёт раскладка */
  .feat__img :global(.media-picture) {
    position: absolute;
    inset: 0;
  }

  .feat__img :global(.media) {
    transition: transform 0.9s var(--ease);
  }

  @media (hover: hover) {
    .feat:hover .feat__img :global(.media) {
      transform: scale(1.03);
    }
  }

  .feat__text {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 22px 24px 24px;
  }

  .feat__title {
    font-family: var(--font-display);
    font-size: clamp(17px, 1.4vw, 19px);
    font-weight: 600;
    line-height: 1.25;
  }

  .feat__text p {
    max-width: 52ch;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .features__note {
    margin-top: 24px;
  }

  /* Широкая карточка: фото слева на всю высоту ряда, текст справа внизу */
  @media (min-width: 721px) {
    .feat--wide {
      flex-direction: row;
    }

    .feat--wide .feat__img {
      flex: 1 1 auto;
      height: auto;
      min-height: calc(var(--img-h) * 1.7);
    }

    .feat--wide .feat__text {
      flex: 0 0 min(320px, 38%);
      align-content: end;
    }
  }

  @media (max-width: 1100px) {
    .features__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      --img-h: calc((100cqw - 16px) / 2 / 2.2);
    }
  }

  /* Телефон: карточки листаются лентой, полоса фото — по ширине карточки */
  @media (max-width: 720px) {
    .features__grid {
      display: flex;
      gap: 12px;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }

    .features__grid::-webkit-scrollbar {
      display: none;
    }

    .feat,
    .feat--wide {
      flex: 0 0 86%;
      scroll-snap-align: start;
    }

    .feat__img {
      height: auto;
      aspect-ratio: 2.2 / 1;
    }

    .feat__text {
      padding: 18px 20px 20px;
    }
  }
</style>
