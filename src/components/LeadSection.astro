---
import LeadForm from './LeadForm.astro';
import Media from './Media.astro';
import type { Photo } from '../data/types';

interface Props {
  /** Модель страницы; на главной не задаётся — там выбор из models */
  model?: string;
  models?: string[];
  trims?: { id: string; name: string }[];
  photo: Photo;
  title?: string;
}
const { model = '', models = [], trims = [], photo, title = `Почувствуйте ${model} за рулём` } = Astro.props;
---

<section class="lead-sec section section--dark" id="test-drive">
  <div class="lead-sec__bg" aria-hidden="true">
    <Media photo={photo} dark sizes="100vw" full />
  </div>
  <div class="container lead-sec__grid">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Тест-драйв</span>
      <h2 class="h-section">{title}</h2>
      <p class="lead">
        Запишитесь на тест-драйв — подготовим автомобиль к вашему приезду, покажем все функции и рассчитаем
        стоимость на учёте РФ и КГ.
      </p>
    </div>
    <div class="lead-sec__card" data-reveal>
      <LeadForm id="section" model={model} models={models} trims={trims} />
    </div>
  </div>
</section>

<style>
  .lead-sec {
    position: relative;
    overflow: hidden;
    overflow: clip;
    isolation: isolate;
    border-top: 1px solid var(--line);
  }

  .lead-sec__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.4;
  }

  .lead-sec__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--bg) 22%, rgb(8 9 11 / 0.45) 100%);
  }

  .lead-sec__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 500px);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }

  .lead-sec .lead {
    color: #c3c6cb;
  }

  .lead-sec__card {
    padding: clamp(24px, 3vw, 36px);
    border-radius: 24px;
    background: rgb(18 19 23 / 0.92);
    border: 1px solid var(--line-2);
    --f-surface: rgb(18 19 23);
  }

  .lead-sec__card :global(.lead-form) {
    --f-surface: #121317;
  }

  @media (max-width: 900px) {
    .lead-sec__grid {
      grid-template-columns: 1fr;
    }

    .lead-sec__bg::after {
      background: linear-gradient(180deg, var(--bg) 10%, rgb(8 9 11 / 0.7) 100%);
    }
  }
</style>
