---
import type { CarModel } from '../data/types';
import Media from './Media.astro';

interface Props {
  interior: NonNullable<CarModel['interior']>;
}
const { interior } = Astro.props;

// На весь экран — только достаточно крупное фото. Меньшее (например, 1920 px) ставим в рамку
// по ширине контента в его пропорциях, без «раскрытия» и увеличения при прокрутке.
const src = interior.photo.src;
const full = !src || src.width >= 2400;
---

<section class="interior section" id="interior">
  <div class="container section-head section-head--center" data-reveal>
    <span class="eyebrow">Салон</span>
    <h2 class="h-section">{interior.title}</h2>
    <p class="lead">{interior.text}</p>
  </div>

  {
    full ? (
      <div class="interior__stage" data-expand>
        <div class="interior__img" data-expand-target>
          <Media photo={interior.photo} sizes="100vw" full />
        </div>
      </div>
    ) : (
      <div class="container" data-reveal>
        <div class="interior__img interior__img--boxed" style={`aspect-ratio:${src.width}/${src.height}`}>
          <Media photo={interior.photo} sizes="(max-width: 1280px) 100vw, 1280px" full />
        </div>
      </div>
    )
  }

  <div class="container">
    <ul class="interior__features">
      {
        interior.features.map((f) => (
          <li data-reveal>
            <h3 class="h-card">{f.title}</h3>
            <p>{f.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .interior {
    background: var(--bg);
    border-top: 1px solid var(--line);
  }

  .interior .section-head {
    margin-bottom: 48px;
  }

  .interior__stage {
    overflow: hidden;
    overflow: clip;
  }

  .interior__img {
    height: min(92vh, 960px);
    overflow: hidden;
    will-change: clip-path;
  }

  .interior__img--boxed {
    height: auto;
    border-radius: 24px;
    border: 1px solid var(--line);
  }

  .interior__features {
    list-style: none;
    margin: clamp(48px, 6vw, 72px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
  }

  .interior__features li {
    display: grid;
    align-content: start;
    gap: 10px;
    padding-top: 22px;
    border-top: 1px solid var(--line-2);
  }

  .interior__features p {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  @media (max-width: 960px) {
    .interior__features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .interior__features {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    /* Квадрат вместо высокого кадра: меньше обрезки и увеличения широкого фото */
    .interior__img {
      height: auto;
      aspect-ratio: 1;
    }

    .interior__img--boxed {
      border-radius: 18px;
    }
  }
</style>
