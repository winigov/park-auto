---
import type { CarModel } from '../data/types';
import { formatPrice, minPrice } from '../scripts/format';
import Media from './Media.astro';

interface Props {
  model: CarModel;
}
const { model } = Astro.props;
const fromRf = minPrice(model.trims, 'rf');
const fromKg = minPrice(model.trims, 'kg');
---

<section class="hero" data-hero>
  <div
    class:list={['hero__bg', { 'hero__bg--offset': model.heroOffset }]}
    style={model.heroOffset ? `--hero-offset:${model.heroOffset}%` : undefined}
    data-hero-bg
  >
    <Media photo={model.hero} priority dark />
  </div>
  <div class="hero__shade"></div>

  <div class="container hero__top" data-hero-content>
    <div class="hero__badges">
      <span class:list={['badge', { 'badge--order': model.availability !== 'in-stock' }]}>
        {model.availability === 'in-stock' ? 'В наличии в Махачкале' : 'Под заказ'}
      </span>
      <span class="badge">Учёт РФ и КР</span>
    </div>
    <p class="hero__brand">{model.brand}</p>
    <h1 class="h-display hero__title">
      <span class="visually-hidden">{model.brand} </span>{model.name}
    </h1>
    <p class="hero__tagline">{model.tagline}</p>
  </div>

  <div class="container hero__bottom" data-hero-content>
    <dl class="hero__prices">
      <div>
        <dt>На учёте РФ</dt>
        <dd>от {formatPrice(fromRf)}</dd>
      </div>
      <div>
        <dt>На учёте КР</dt>
        <dd>от {formatPrice(fromKg)}</dd>
      </div>
    </dl>
    <div class="hero__cta">
      <button class="btn" type="button" data-open-lead data-intent="test-drive">Записаться на тест-драйв</button>
      <a class="btn btn--ghost" href="#trims">Комплектации и цены</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    overflow: clip; /* обрезает, но не делает блок прокручиваемым */
    background: var(--dark);
    color: var(--on-dark);
    isolation: isolate;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    transform-origin: 50% 70%;
  }

  .hero__bg--offset {
    top: var(--hero-offset);
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 22%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 22%);
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(8 9 11 / 0.72) 0%, rgb(8 9 11 / 0.35) 24%, rgb(8 9 11 / 0) 46%),
      linear-gradient(0deg, rgb(8 9 11 / 0.9) 0%, rgb(8 9 11 / 0.3) 22%, rgb(8 9 11 / 0) 40%);
  }

  .hero__top {
    padding-top: calc(var(--header-h) + clamp(24px, 5vh, 56px));
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: clamp(16px, 3vh, 28px);
  }

  .hero__brand {
    font-size: clamp(14px, 1.3vw, 17px);
    font-weight: 700;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.75);
    margin-bottom: 6px;
  }

  .hero__title {
    font-size: clamp(56px, 10vw, 150px);
    text-shadow: 0 4px 40px rgb(0 0 0 / 0.25);
  }

  .hero__tagline {
    margin-top: 14px;
    font-size: clamp(18px, 2vw, 26px);
    font-weight: 500;
    letter-spacing: -0.01em;
    max-width: 34ch;
    color: rgb(255 255 255 / 0.9);
  }

  .hero__bottom {
    padding-top: 32px;
    padding-bottom: clamp(28px, 5vh, 56px);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 40px;
  }

  .hero__prices {
    display: flex;
    gap: clamp(24px, 4vw, 56px);
    margin: 0;
  }

  .hero__prices dt {
    font-size: 14px;
    color: var(--on-dark-2);
    margin-bottom: 4px;
  }

  .hero__prices dd {
    margin: 0;
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 750;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Телефон: фото — полосой посередине, чтобы машина не обрезалась */
  @media (max-width: 720px) and (orientation: portrait) {
    .hero__bg {
      inset: 30% 0 auto;
      height: 46%;
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 22%, #000 70%, transparent 100%);
      mask-image: linear-gradient(180deg, transparent 0%, #000 22%, #000 70%, transparent 100%);
    }

    .hero__shade {
      display: none;
    }

    .hero {
      background:
        radial-gradient(120% 40% at 50% 8%, #1d2b45 0%, transparent 70%),
        linear-gradient(180deg, #0c1220 0%, var(--dark) 70%);
    }
  }

  @media (max-width: 720px) {
    .hero__prices {
      width: 100%;
      justify-content: space-between;
    }

    .hero__cta {
      width: 100%;
    }

    .hero__cta .btn {
      flex: 1 1 100%;
    }
  }
</style>
