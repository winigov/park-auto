---
import type { CarModel } from '../data/types';
import { formatPrice, minPrice } from '../scripts/format';
import Media from './Media.astro';

interface Props {
  model: CarModel;
}
const { model } = Astro.props;
const fromRf = minPrice(model.trims, 'rf');
const fromKg = minPrice(model.trims, 'kg');
---

<section class="hero" data-hero>
  <div
    class:list={['hero__bg', { 'hero__bg--offset': model.heroOffset }]}
    style={model.heroOffset ? `--hero-offset:${model.heroOffset}%` : undefined}
    data-hero-bg
  >
    <Media photo={model.hero} priority dark full />
  </div>
  <div class="hero__shade"></div>

  <div class="container hero__top" data-hero-content>
    <div class="hero__badges">
      <span class:list={['badge', { 'badge--order': model.availability !== 'in-stock' }]}>
        {model.availability === 'in-stock' ? 'В наличии в Махачкале' : 'Под заказ'}
      </span>
      <span class="badge">Учёт РФ и КГ</span>
    </div>
    <p class="hero__brand">{model.brand}</p>
    <h1 class="h-display metal-text hero__title">
      <span class="visually-hidden">{model.brand} </span>{model.name}
    </h1>
    <p class="hero__tagline">{model.tagline}</p>
  </div>

  <div class="container hero__bottom" data-hero-content>
    <dl class="hero__prices">
      <div>
        <dt>На учёте РФ</dt>
        <dd>от {formatPrice(fromRf)}</dd>
      </div>
      <div>
        <dt>На учёте КГ</dt>
        <dd>от {formatPrice(fromKg)}</dd>
      </div>
    </dl>
    <div class="hero__cta">
      <button class="btn" type="button" data-open-lead data-intent="test-drive">Записаться на тест-драйв</button>
      <a class="btn btn--ghost" href="#trims">Комплектации и цены</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    overflow: clip; /* обрезает, но не делает блок прокручиваемым */
    background: var(--dark);
    color: var(--on-dark);
    isolation: isolate;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    transform-origin: 50% 70%;
  }

  .hero__bg--offset {
    top: var(--hero-offset);
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 22%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 22%);
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(8 9 11 / 0.72) 0%, rgb(8 9 11 / 0.35) 24%, rgb(8 9 11 / 0) 46%),
      linear-gradient(0deg, rgb(8 9 11 / 0.9) 0%, rgb(8 9 11 / 0.3) 22%, rgb(8 9 11 / 0) 40%);
  }

  .hero__top {
    padding-top: calc(var(--header-h) + clamp(24px, 5vh, 56px));
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: clamp(16px, 3vh, 28px);
  }

  .hero__brand {
    margin-bottom: 10px;
    font-family: var(--font-display);
    font-size: clamp(12px, 1vw, 14px);
    font-weight: 500;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--silver);
  }

  .hero__title {
    font-size: clamp(40px, 7.8vw, 112px);
  }

  .hero__tagline {
    margin-top: 16px;
    font-size: clamp(16px, 1.7vw, 24px);
    font-weight: 500;
    max-width: 34ch;
    color: rgb(244 244 242 / 0.92);
  }

  .hero__bottom {
    padding-top: 32px;
    padding-bottom: clamp(28px, 5vh, 56px);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 40px;
  }

  .hero__prices {
    display: flex;
    gap: clamp(24px, 4vw, 56px);
    margin: 0;
  }

  .hero__prices dt {
    font-size: 13px;
    color: var(--ink-2);
    margin-bottom: 6px;
  }

  .hero__prices dd {
    margin: 0;
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 750;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Телефон: фото — полосой посередине, чтобы машина не обрезалась */
  /* Телефон: фото — отдельным блоком между заголовком и ценами, текст на машину не заходит */
  @media (max-width: 720px) and (orientation: portrait) {
    .hero__top {
      order: 1;
    }

    .hero__bg {
      order: 2;
      position: relative;
      inset: auto;
      top: auto;
      z-index: 0;
      flex: 0 0 auto;
      height: clamp(200px, 34svh, 300px);
      margin-top: 8px;
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 16%, #000 84%, transparent 100%);
      mask-image: linear-gradient(180deg, transparent 0%, #000 16%, #000 84%, transparent 100%);
    }

    .hero__bottom {
      order: 3;
      padding-top: 16px;
    }

    .hero__shade {
      display: none;
    }

    .hero {
      background:
        radial-gradient(120% 40% at 50% 6%, #1c1f25 0%, transparent 70%),
        var(--bg);
    }
  }

  @media (max-width: 720px) {
    .hero__top {
      /* отступ от шапки до заголовка на телефоне — вдвое меньше */
      padding-top: calc(var(--header-h) + clamp(12px, 2.5vh, 28px));
    }

    .hero__prices {
      width: 100%;
      justify-content: space-between;
    }

    .hero__cta {
      width: 100%;
    }

    .hero__cta .btn {
      flex: 1 1 100%;
    }
  }

  /* Узкие телефоны (360 px): цены помещаются в одну строку */
  @media (max-width: 380px) {
    .hero__prices dd {
      font-size: 19px;
    }
  }
</style>
